# Lokalno: docker compose up -d (port 5433)
# Render: render.yaml automatski kreira Postgres i DATABASE_URL
DATABASE_URL="postgresql://worldcup:worldcup@localhost:5433/worldcup"

# JWT
JWT_SECRET="promeni-ovo-u-dugacak-random-string"
JWT_EXPIRES_IN="7d"

# API-Football (https://dashboard.api-football.com/register)
# Besplatan plan: 100 req/dan — dovoljno za sync svakih 15-30 min
API_FOOTBALL_KEY="tvoj-api-kljuc"
API_FOOTBALL_LEAGUE_ID=1
API_FOOTBALL_SEASON=2026

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Cron sync (svakih 15 min tokom turnira)
ENABLE_CRON=true
SYNC_CRON="*/15 * * * *"
