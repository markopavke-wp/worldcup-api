# Lokalno: docker compose up -d (port 5433)
# Render: render.yaml automatski kreira Postgres i DATABASE_URL
DATABASE_URL="postgresql://worldcup:worldcup@localhost:5433/worldcup"

# JWT
JWT_SECRET="promeni-ovo-u-dugacak-random-string"
JWT_EXPIRES_IN="7d"

# football-data.org (https://www.football-data.org/client/register) — preporučeno za SP 2026
# Besplatan plan: 10 req/min, FIFA World Cup (WC) uključen
FOOTBALL_DATA_TOKEN="tvoj-token"
FOOTBALL_DATA_COMPETITION=WC
FOOTBALL_DATA_SEASON=2026

# API-Football (https://dashboard.api-football.com/register) — opciono
# Besplatan plan ne podržava sezonu 2026; koristi football-data.org iznad
API_FOOTBALL_KEY=""
API_FOOTBALL_LEAGUE_ID=1
API_FOOTBALL_SEASON=2026

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Cron sync (svakih 15 min tokom turnira)
ENABLE_CRON=true
SYNC_CRON="*/15 * * * *"
