{
  "name": "worldcup-api",
  "version": "1.0.0",
  "description": "World Cup 2026 predictions API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "sync": "node src/jobs/runSync.js",
    "test:predictions": "node src/scripts/testPredictions.js",
    "cleanup": "node src/scripts/cleanupTestData.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.1.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "prisma": "^6.9.0"
  }
}
